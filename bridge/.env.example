# Проект общий с серверами майнкрафта: отсюда сеть mc-server_default.
COMPOSE_PROJECT_NAME=mc-server

# Откуда брать базовые образы при сборке. Если Docker Hub недоступен
# (из России так и есть) — mirror.gcr.io.
REGISTRY=docker.io

# Общий секрет с модом (bridgeToken в config/syrradio-server.toml).
# Сгенерировать: openssl rand -hex 24
BRIDGE_TOKEN=

# Токен Яндекс Музыки (аккаунт с Плюсом). Пусто — Яндекс выключен.
YANDEX_TOKEN=

# HTTP-прокси для YouTube (из России он заблокирован). Пусто — напрямую.
PROXY_YOUTUBE=
# HTTP-прокси для остальных площадок через yt-dlp (SoundCloud тоже
# заблокирован в России). Яндекс всегда идёт напрямую.
PROXY_OTHER=

MAX_DURATION_SEC=1200
CACHE_TTL_SEC=3600
OGG_QUALITY=3
YTDLP_AUTO_UPDATE=true
